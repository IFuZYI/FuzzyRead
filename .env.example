# Server
PORT=3000
NODE_ENV=development

# Public URL used in share links / metadata
APP_URL=http://localhost:3000

# Set when running behind Nginx/Cloudflare so req.ip is the real client IP
# (the /admin login throttle keys on it). "1" = trust one proxy hop.
TRUST_PROXY=

# Merged-project paths (all relative to the project root)
DATA_DIR=data
HARVESTER_DIR=harvester
ARTICLES_DIR=data/articles
PYTHON_BIN=.venv/bin/python

# Required to enable /admin operations
ADMIN_PASSWORD=change-this-password

# Kill a harvest job that runs longer than this (ms). Default 1 hour.
JOB_TIMEOUT_MS=3600000

# Optional provider keys
GEMINI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
FASTAPI_DICT_URL=

# Allow server-held keys for built-in features
ALLOW_SERVER_KEY_DICTIONARY=true
ALLOW_SERVER_KEY_WORD_TTS=true
ALLOW_SERVER_KEY_PARAGRAPH_TRANSLATE=false
ALLOW_SERVER_KEY_PARAGRAPH_TTS=false
