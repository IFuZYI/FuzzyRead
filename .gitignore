# Node / build output
node_modules/
dist/
*.tsbuildinfo

# Environment and secrets
.env
.env.*
!.env.example

# Python runtime
.venv/
venv/
__pycache__/
*.pyc

# Runtime data: keep empty directory markers, never commit content
/data/articles/*
!/data/articles/.gitkeep
/data/logs/*
!/data/logs/.gitkeep
/data/state/*
!/data/state/.gitkeep
debug.log
*.log

# Archived / local-only artifacts
archive/
.hermes/
.vscode/

# Editor / OS
.DS_Store
